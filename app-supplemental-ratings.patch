+# ----------------------------------------------------------------------
+# Supplemental ratings: Dependence, Durability and Who was studied.
+# An agent pre-fills; a coder or the lead confirms. Never an input to a rating.
+# Every query runs under the person's own coder sign-in, so the database decides what they may see and change.
+# ----------------------------------------------------------------------
+SUPP = {
+    "dependence": ("tracker.study_dependence", "tracker.confirm_dependence", "confirmed_by", "confirmed_at",
+                   ["tool_design", "tool_design_quote", "tool_design_page", "transfer_evidence", "transfer_quote", "transfer_page",
+                    "teacher_role", "teacher_quote", "teacher_page", "note"]),
+    "durability": ("tracker.study_durability", "tracker.confirm_durability", "confirmed_by", "confirmed_at",
+                   ["measured_after_removal", "measured_quote", "measured_page", "interval_after",
+                    "effect_held", "effect_quote", "effect_page", "note"]),
+    "who": ("tracker.who_was_studied", "tracker.confirm_who_was_studied", "verified_by", "verified_at",
+            ["w1_stage", "w2_described", "w3_analyzed", "w4_omission_acknowledged", "quotes"]),
+}
+
+
+def _supp_available(c) -> bool:
+    return c.execute("SELECT to_regclass('tracker.study_durability') IS NOT NULL AS ok").fetchone()["ok"]
+
+
+def _supp_state(c):
+    out = {}
+    for item, (table, _fn, by, at, fields) in SUPP.items():
+        extra = ", rating" if item == "who" else ""
+        rows = c.execute(f"""SELECT x.study_id, {", ".join("x." + f for f in fields)}{extra},
+                                    (SELECT p.name FROM admin.people p WHERE p.person_id = x.{by}) AS confirmed_by,
+                                    x.{at} AS confirmed_at,
+                                    (SELECT p.name FROM admin.people p WHERE p.person_id = x.prefilled_by) AS prefilled_by
+                             FROM {table} x""").fetchall()
+        for r in rows:
+            if item == "who":
+                r["w1_stage"] = r["w1_stage"] and str(r["w1_stage"])
+            out.setdefault(r.pop("study_id"), {})[item] = r
+    studies = c.execute("SELECT study_id, citation FROM tracker.studies WHERE study_id = ANY(%s) ORDER BY study_id",
+                        (list(out),)).fetchall()
+    for s in studies:
+        s.update({k: out[s["study_id"]].get(k) for k in SUPP})
+    return {"studies": studies,
+            "categories": c.execute("SELECT code, label FROM tracker.vulnerable_categories ORDER BY grouping, label").fetchall(),
+            "stages": [r["v"] for r in c.execute("SELECT unnest(enum_range(NULL::tracker.dev_stage))::text AS v")]}
+
+
+@app.get("/api/supplemental")
+def supplemental(request: Request):
+    with db(current_login(request)) as c:
+        if not _supp_available(c):
+            raise HTTPException(404, "Supplemental ratings are not available yet")
+        return _supp_state(c)
+
+
+@app.patch("/api/supplemental/{study_id}/{item}")
+def supplemental_change(study_id: str, item: str, body: dict, request: Request):
+    if item not in SUPP:
+        raise HTTPException(404, "No such record")
+    table, _fn, _by, _at, fields = SUPP[item]
+    sets = {k: v for k, v in body.items() if k in fields}
+    if not sets:
+        raise HTTPException(400, "Nothing to change")
+    for k in ("quotes",):
+        if k in sets:
+            sets[k] = Jsonb(sets[k])
+    for k, v in list(sets.items()):
+        if isinstance(v, str) and not v.strip():
+            sets[k] = None
+    with db(current_login(request)) as c:
+        cur = c.execute(f"UPDATE {table} SET {', '.join(k + ' = %s' for k in sets)} WHERE study_id = %s",
+                        (*sets.values(), study_id))
+        if cur.rowcount == 0:
+            raise HTTPException(404, "No record for this study that you can change")
+        return _supp_state(c)
+
+
+@app.post("/api/supplemental/{study_id}/{item}/confirm")
+def supplemental_confirm(study_id: str, item: str, request: Request):
+    if item not in SUPP:
+        raise HTTPException(404, "No such record")
+    with db(current_login(request)) as c:
+        c.execute(f"SELECT {SUPP[item][1]}(%s)", (study_id,))
+        return _supp_state(c)
+
